        "jsCode": "return [\n  { json: { raw_log: \"2025-11-27 10:15:30 [INFO] [192.168.1.10] User login successful\" } },\n  { json: { raw_log: \"2025-11-27 10:16:05 [Error] [10.0.0.5] DB_CONN_TIMEOUT: Retrying...\" } },\n  { json: { raw_log: \"2025-11-27 10:17:12 [WARN] [192.168.1.10] High memory usage: 85%\" } }\n];"
