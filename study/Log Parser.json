      ],
      "id": "fb2b2e46-baa1-4cd2-a20e-f56bee4b1deb",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Define the Regex Pattern\n// Group 1: Timestamp\n// Group 2: Level (inside brackets)\n// Group 3: IP (inside brackets)\n// Group 4: The rest of the message\nconst regex = /^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}) \\[(.*?)\\] \\[(.*?)\\] (.*)$/;\n\n// Process each item\nfor (const item of $input.all()) {\n  const logLine = item.json.raw_log;\n  const match = logLine.match(regex);\n\n  if (match) {\n    // If regex matches, create structured fields\n    item.json.timestamp = match[1];\n    item.json.level = match[2].toUpperCase();\n    item.json.ip = match[3];\n    item.json.message = match[4];\n    item.json.parsed = true;\n  } else {\n    // Handle parse failures\n    item.json.parsed = false;\n  }\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
